{
  "name": "forma-frontend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:tokens": "tailwindcss -i ./tests/tailwind.css -o ./.checks/sky-ui.css && node scripts/check-tokens.mjs",
    "check": "npm run typecheck && npm run check:tokens && npm test",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test:browser": "playwright test",
    "predev": "npm run build -w skyloom-ui",
    "prebuild": "npm run build -w skyloom-ui",
    "precheck": "npm run build -w skyloom-ui"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.19"
  },
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skyloom-ui": "^0.1.0"
  }
}
